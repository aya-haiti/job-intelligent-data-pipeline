# Copy to .env and fill with NEW credentials. Never commit .env.
# --- Docker stack (Airflow / Postgres / MinIO) ---
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3
POSTGRES_AIRFLOW_USER=
POSTGRES_AIRFLOW_PASSWORD=
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_DWH_USER=
POSTGRES_DWH_PASSWORD=
POSTGRES_DWH_DB=dwh
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# --- Scraper API keys (rotate the old ones first!) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# --- Web dashboard (server-side only) ---
# Postgres connection string read by interface/data_source.py (Neon in production)
DATABASE_URL=
# Or a local CSV instead of Postgres
JOBS_CSV_PATH=
